{
  "uuid": "reimbursement",
  "subPage": false,
  "quotes": [],
  "dependencies": [],
  "name": "报销申请",
  "layoutUuid": "mokelay_layout",
  "blocks": [
    {
      "id": "reimbursement-form-state",
      "type": "MPageState",
      "data": {
        "initialState": {
          "record": {},
          "ready": false,
          "locked": true,
          "busy": true,
          "submitted": false,
          "hideRetry": true,
          "failedBlock": "reimbursement-form",
          "failedEvent": "init",
          "statusMessage": ""
        }
      }
    },
    {
      "id": "reimbursement-form-title",
      "type": "MHeading",
      "data": {
        "text": "报销申请",
        "level": "1",
        "align": "left"
      }
    },
    {
      "id": "reimbursement-form-status",
      "type": "MRichText",
      "data": {
        "content": {
          "mode": "variable",
          "source": "Block",
          "blockId": "reimbursement-form-state",
          "variable": "statusMessage"
        }
      }
    },
    {
      "id": "reimbursement-form",
      "type": "MForm",
      "data": {
        "defaultValues": {
          "show_help": "no",
          "category": "",
          "fiat": "",
          "crypto": "",
          "loan": "",
          "settlement": "0.00",
          "approval_amount": "0",
          "note": ""
        },
        "items": [
          {
            "variableName": "show_help",
            "labelName": "是否需要展示填单说明",
            "layout": "Horizontal",
            "fieldDataType": "string",
            "editor": {
              "id": "expense-show_help",
              "type": "MSelectField",
              "data": {
                "options": [
                  {
                    "value": "no",
                    "label": "否，不需要展示说明"
                  },
                  {
                    "value": "yes",
                    "label": "是，需要展示说明"
                  }
                ]
              },
              "events": [
                {
                  "event": "change",
                  "execution": {
                    "concurrency": "serialLatest"
                  },
                  "actions": [
                    {
                      "uuid": "expense-show_help-hint-visibility",
                      "action": "switch_controller",
                      "type": "controller",
                      "inputs": {
                        "dataType": "string",
                        "value": {
                          "template": "{{event.value}}"
                        }
                      },
                      "nodes": [
                        {
                          "uuid": "show",
                          "value": "yes",
                          "nextAction": "show_hints"
                        },
                        {
                          "uuid": "hide",
                          "type": "DEFAULT",
                          "nextAction": "hide_hints"
                        }
                      ],
                      "nextAction": null
                    },
                    {
                      "uuid": "show_hints",
                      "action": "call_block_method",
                      "inputs": {
                        "blockId": "reimbursement-form",
                        "method": "setStatus",
                        "showHints": true
                      },
                      "outputs": [
                        "returnData"
                      ],
                      "nextAction": null
                    },
                    {
                      "uuid": "hide_hints",
                      "action": "call_block_method",
                      "inputs": {
                        "blockId": "reimbursement-form",
                        "method": "setStatus",
                        "showHints": false
                      },
                      "outputs": [
                        "returnData"
                      ],
                      "nextAction": null
                    }
                  ]
                }
              ]
            },
            "rules": {
              "description": "⬆️填单说明：\n1.申请单页面各字段下会展示这一字段的解释说明与填写提示。\n2.若需展示填单说明，可选择“是，需要展示说明”。"
            }
          },
          {
            "variableName": "category",
            "labelName": "申请报销类别",
            "layout": "Horizontal",
            "fieldDataType": "string",
            "editor": {
              "id": "expense-category",
              "type": "MSelectField",
              "data": {
                "options": [],
                "required": true,
                "placeholder": "请选择"
              }
            },
            "rules": {
              "hint": "选择本次报销的费用类别。"
            }
          },
          {
            "variableName": "fiat",
            "labelName": "法定货币报销金额（折合 USDT）",
            "layout": "Horizontal",
            "fieldDataType": "string",
            "editor": {
              "id": "expense-fiat",
              "type": "MInput",
              "data": {
                "placeholder": "0.00",
                "inputMode": "decimal"
              }
            },
            "rules": {
              "visibleWhen": {
                "field": "category"
              },
              "hint": "填写已折合为 USDT 的法币报销总额。",
              "pattern": "^[0-9]{1,14}(\\.[0-9]{1,2})?$",
              "invalidMessage": "请输入非负金额，整数最多 14 位，小数最多 2 位。"
            }
          },
          {
            "variableName": "crypto",
            "labelName": "数字货币报销金额（USDT）",
            "layout": "Horizontal",
            "fieldDataType": "string",
            "editor": {
              "id": "expense-crypto",
              "type": "MInput",
              "data": {
                "placeholder": "0.00",
                "inputMode": "decimal"
              }
            },
            "rules": {
              "visibleWhen": {
                "field": "category"
              },
              "hint": "填写以 USDT 计价的数字货币报销总额。",
              "pattern": "^[0-9]{1,14}(\\.[0-9]{1,2})?$",
              "invalidMessage": "请输入非负金额，整数最多 14 位，小数最多 2 位。"
            }
          },
          {
            "variableName": "loan",
            "labelName": "借款金额（USDT）",
            "layout": "Horizontal",
            "fieldDataType": "string",
            "editor": {
              "id": "expense-loan",
              "type": "MInput",
              "data": {
                "placeholder": "0.00",
                "inputMode": "decimal"
              }
            },
            "rules": {
              "visibleWhen": {
                "field": "category"
              },
              "hint": "填写本次抵扣的借款，没有借款可留空。",
              "pattern": "^[0-9]{1,14}(\\.[0-9]{1,2})?$",
              "invalidMessage": "请输入非负金额，整数最多 14 位，小数最多 2 位。"
            }
          },
          {
            "variableName": "settlement",
            "labelName": "应补或应退金额\n（USDT）",
            "layout": "Horizontal",
            "fieldDataType": "string",
            "editor": {
              "id": "expense-settlement",
              "type": "MInput",
              "data": {
                "disabled": true
              }
            },
            "rules": {
              "readOnly": true,
              "description": "⬆️填单说明-报销款结算：\n1.公司报销款结算为USDT。\n2.报销款结算金额合计\n= 法定货币报销金额合计（折合USDT）+ 数字货币报销数量合计（USDT）- 借款金额（USDT）\n= 应补或应退金额（USDT）"
            }
          },
          {
            "variableName": "approval_amount",
            "labelName": "审批条件用金额（请忽略）",
            "layout": "Horizontal",
            "fieldDataType": "string",
            "editor": {
              "id": "expense-approval_amount",
              "type": "MInput",
              "data": {
                "disabled": true
              }
            },
            "rules": {
              "readOnly": true
            }
          },
          {
            "variableName": "note",
            "labelName": "备注",
            "layout": "Vertical",
            "fieldDataType": "string",
            "editor": {
              "id": "expense-note",
              "type": "MTextareaField",
              "data": {
                "placeholder": "其他补充说明",
                "maxLength": 2000,
                "rows": 2
              }
            },
            "rules": {
              "hint": "可填写与本次报销有关的其他信息。"
            }
          }
        ]
      },
      "events": [
        {
          "event": "init",
          "execution": {
            "concurrency": "drop"
          },
          "actions": [
            {
              "uuid": "loading",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form",
                "method": "setStatus",
                "loading": true,
                "disabled": true,
                "errors": [],
                "showHints": false
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "loading-message"
            },
            {
              "uuid": "loading-message",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form-state",
                "method": "merge",
                "value": {
                  "statusMessage": "正在加载…"
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "load"
            },
            {
              "uuid": "load",
              "action": "execute_ds",
              "inputs": {
                "dsConfig": {
                  "type": "API",
                  "domain": "mokelay",
                  "path": "/api/lark/reimbursement_init",
                  "method": "GET",
                  "headerData": [],
                  "queryData": [],
                  "bodyData": []
                }
              },
              "outputs": [
                "rawResponse"
              ],
              "nextAction": "store_record"
            },
            {
              "uuid": "store_record",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form-state",
                "method": "merge",
                "value": {
                  "record": {
                    "template": "{{actions.load.outputs.rawResponse.data.record}}"
                  },
                  "hideRetry": true
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "restore_fields"
            },
            {
              "uuid": "restore_fields",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form",
                "method": "setValues",
                "values": {
                  "show_help": {
                    "template": "{{actions.load.outputs.rawResponse.data.record.show_help}}"
                  },
                  "category": {
                    "template": "{{actions.load.outputs.rawResponse.data.record.category}}"
                  },
                  "fiat": {
                    "template": "{{actions.load.outputs.rawResponse.data.record.fiat}}"
                  },
                  "crypto": {
                    "template": "{{actions.load.outputs.rawResponse.data.record.crypto}}"
                  },
                  "loan": {
                    "template": "{{actions.load.outputs.rawResponse.data.record.loan}}"
                  },
                  "settlement": {
                    "template": "{{actions.load.outputs.rawResponse.data.record.settlement}}"
                  },
                  "note": {
                    "template": "{{actions.load.outputs.rawResponse.data.record.note}}"
                  }
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "expense-show_help-sync-hints"
            },
            {
              "uuid": "expense-show_help-sync-hints",
              "action": "trigger_event",
              "inputs": {
                "blockId": "expense-show_help",
                "event": "change",
                "payload": {
                  "value": {
                    "template": "{{actions.restore_fields.outputs.returnData.values.show_help}}"
                  }
                }
              },
              "outputs": [
                "result"
              ],
              "nextAction": "options"
            },
            {
              "uuid": "options",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form",
                "method": "setFieldOptions",
                "options": {
                  "template": "{{actions.load.outputs.rawResponse.data.options}}"
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "ready"
            },
            {
              "uuid": "ready",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form-state",
                "method": "merge",
                "value": {
                  "locked": false,
                  "ready": true
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "loaded"
            },
            {
              "uuid": "loaded",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form",
                "method": "setStatus",
                "errors": []
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "loaded-message"
            },
            {
              "uuid": "loaded-message",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form-state",
                "method": "merge",
                "value": {
                  "statusMessage": "将自动保存填写内容"
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": null
            }
          ],
          "onError": [
            {
              "uuid": "remember_failure",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form-state",
                "method": "merge",
                "value": {
                  "hideRetry": false,
                  "failedBlock": "reimbursement-form",
                  "failedEvent": "init"
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "show_error"
            },
            {
              "uuid": "show_error",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form",
                "method": "setStatus",
                "errors": [
                  {
                    "message": {
                      "template": "{{event.error.message}}"
                    }
                  }
                ]
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "show_error-message"
            },
            {
              "uuid": "show_error-message",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form-state",
                "method": "merge",
                "value": {
                  "statusMessage": "初始化失败"
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": null
            }
          ],
          "onFinally": [
            {
              "uuid": "finish_init",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form-state",
                "method": "merge",
                "value": {
                  "busy": false
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "finish_loading"
            },
            {
              "uuid": "finish_loading",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form",
                "method": "setStatus",
                "loading": false,
                "disabled": {
                  "template": "{{blocks['reimbursement-form-state'].locked}}"
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": null
            }
          ]
        },
        {
          "event": "change",
          "execution": {
            "concurrency": "serialLatest",
            "debounceMs": 400,
            "retry": "resumeUnconfirmed",
            "flushOn": [
              "hidden",
              "unmount"
            ]
          },
          "actions": [
            {
              "uuid": "valid",
              "action": "if_controller",
              "type": "controller",
              "inputs": {
                "value": {
                  "template": "{{event.valid}}"
                }
              },
              "nodes": [
                {
                  "uuid": "yes",
                  "value": true,
                  "nextAction": "saving"
                },
                {
                  "uuid": "no",
                  "value": false,
                  "nextAction": null
                }
              ],
              "nextAction": null
            },
            {
              "uuid": "saving",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form",
                "method": "setStatus",
                "errors": []
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "saving-message"
            },
            {
              "uuid": "saving-message",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form-state",
                "method": "merge",
                "value": {
                  "statusMessage": "正在保存…"
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "save"
            },
            {
              "uuid": "save",
              "action": "execute_ds",
              "inputs": {
                "dsConfig": {
                  "type": "API",
                  "domain": "mokelay",
                  "path": "/api/lark/reimbursement_save_draft",
                  "method": "POST",
                  "headerData": [],
                  "queryData": [],
                  "bodyData": [
                    {
                      "key": "id",
                      "dataType": "string",
                      "value": {
                        "template": "{{blocks['reimbursement-form-state'].record.id}}"
                      }
                    },
                    {
                      "key": "version",
                      "dataType": "number",
                      "value": {
                        "template": "{{blocks['reimbursement-form-state'].record.version}}"
                      }
                    },
                    {
                      "key": "show_help",
                      "dataType": "string",
                      "value": {
                        "template": "{{event.values.show_help}}"
                      }
                    },
                    {
                      "key": "category",
                      "dataType": "string",
                      "value": {
                        "template": "{{event.values.category}}"
                      }
                    },
                    {
                      "key": "fiat",
                      "dataType": "string",
                      "value": {
                        "template": "{{event.values.fiat}}"
                      }
                    },
                    {
                      "key": "crypto",
                      "dataType": "string",
                      "value": {
                        "template": "{{event.values.crypto}}"
                      }
                    },
                    {
                      "key": "loan",
                      "dataType": "string",
                      "value": {
                        "template": "{{event.values.loan}}"
                      }
                    },
                    {
                      "key": "note",
                      "dataType": "string",
                      "value": {
                        "template": "{{event.values.note}}"
                      }
                    }
                  ]
                }
              },
              "outputs": [
                "rawResponse"
              ],
              "nextAction": "store_record"
            },
            {
              "uuid": "store_record",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form-state",
                "method": "merge",
                "value": {
                  "record": {
                    "template": "{{actions.save.outputs.rawResponse.data.record}}"
                  },
                  "hideRetry": true
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "restore_fields"
            },
            {
              "uuid": "restore_fields",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form",
                "method": "setValues",
                "values": {
                  "settlement": {
                    "template": "{{actions.save.outputs.rawResponse.data.record.settlement}}"
                  }
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "saved"
            },
            {
              "uuid": "saved",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form",
                "method": "setStatus",
                "errors": []
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "saved-message"
            },
            {
              "uuid": "saved-message",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form-state",
                "method": "merge",
                "value": {
                  "statusMessage": "草稿已保存"
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": null
            }
          ],
          "onError": [
            {
              "uuid": "remember_failure",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form-state",
                "method": "merge",
                "value": {
                  "hideRetry": false,
                  "failedBlock": "reimbursement-form",
                  "failedEvent": "change"
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "show_error"
            },
            {
              "uuid": "show_error",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form",
                "method": "setStatus",
                "errors": [
                  {
                    "message": {
                      "template": "{{event.error.message}}"
                    }
                  }
                ]
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "show_error-message"
            },
            {
              "uuid": "show_error-message",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form-state",
                "method": "merge",
                "value": {
                  "statusMessage": "草稿未保存"
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": null
            }
          ]
        }
      ]
    },
    {
      "id": "reimbursement-form-retry",
      "type": "MButton",
      "data": {
        "label": "重试",
        "variant": "text",
        "align": "center",
        "hidden": {
          "mode": "variable",
          "source": "Block",
          "blockId": "reimbursement-form-state",
          "variable": "hideRetry"
        },
        "disabled": {
          "mode": "variable",
          "source": "Block",
          "blockId": "reimbursement-form-state",
          "variable": "busy"
        }
      },
      "events": [
        {
          "event": "click",
          "execution": {
            "concurrency": "drop"
          },
          "actions": [
            {
              "uuid": "retry_busy",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form-state",
                "method": "merge",
                "value": {
                  "busy": true,
                  "locked": true
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "retry_lock"
            },
            {
              "uuid": "retry_lock",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form",
                "method": "setStatus",
                "disabled": true
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "retry"
            },
            {
              "uuid": "retry",
              "action": "retry_event",
              "inputs": {
                "blockId": {
                  "template": "{{blocks['reimbursement-form-state'].failedBlock}}"
                },
                "event": {
                  "template": "{{blocks['reimbursement-form-state'].failedEvent}}"
                }
              },
              "nextAction": null
            }
          ],
          "onError": [
            {
              "uuid": "retry_error",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form",
                "method": "setStatus",
                "errors": [
                  {
                    "message": {
                      "template": "{{event.error.message}}"
                    }
                  }
                ]
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": null
            }
          ],
          "onFinally": [
            {
              "uuid": "retry_ready",
              "action": "if_controller",
              "type": "controller",
              "inputs": {
                "value": {
                  "template": "{{blocks['reimbursement-form-state'].ready}}"
                }
              },
              "nodes": [
                {
                  "uuid": "yes",
                  "value": true,
                  "nextAction": "retry_finished"
                },
                {
                  "uuid": "no",
                  "value": false,
                  "nextAction": "retry_not_ready"
                }
              ],
              "nextAction": null
            },
            {
              "uuid": "retry_finished",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form-state",
                "method": "merge",
                "value": {
                  "busy": false,
                  "locked": {
                    "template": "{{blocks['reimbursement-form-state'].submitted}}"
                  }
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "retry_unlock"
            },
            {
              "uuid": "retry_not_ready",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form-state",
                "method": "merge",
                "value": {
                  "busy": false,
                  "locked": true
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "retry_unlock"
            },
            {
              "uuid": "retry_unlock",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form",
                "method": "setStatus",
                "disabled": {
                  "template": "{{blocks['reimbursement-form-state'].locked}}"
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": null
            }
          ]
        }
      ]
    },
    {
      "id": "reimbursement-submit",
      "type": "MButton",
      "data": {
        "label": "提交",
        "variant": "primary",
        "align": "center",
        "width": "min(568px, calc(100% - 32px))",
        "disabled": {
          "mode": "variable",
          "source": "Block",
          "blockId": "reimbursement-form-state",
          "variable": "locked"
        },
        "hidden": {
          "mode": "variable",
          "source": "Block",
          "blockId": "reimbursement-form-state",
          "variable": "submitted"
        }
      },
      "events": [
        {
          "event": "click",
          "actions": [
            {
              "uuid": "lock",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form-state",
                "method": "merge",
                "value": {
                  "locked": true,
                  "busy": true
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "submitting"
            },
            {
              "uuid": "submitting",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form",
                "method": "setStatus",
                "disabled": true,
                "errors": []
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "submitting-message"
            },
            {
              "uuid": "submitting-message",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form-state",
                "method": "merge",
                "value": {
                  "statusMessage": "正在提交…"
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "flush"
            },
            {
              "uuid": "flush",
              "action": "flush_event",
              "inputs": {
                "blockId": "reimbursement-form",
                "event": "change"
              },
              "nextAction": "validate"
            },
            {
              "uuid": "validate",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form",
                "method": "submit"
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "valid"
            },
            {
              "uuid": "valid",
              "action": "if_controller",
              "type": "controller",
              "inputs": {
                "value": {
                  "template": "{{actions.validate.outputs.returnData.valid}}"
                }
              },
              "nodes": [
                {
                  "uuid": "yes",
                  "value": true,
                  "nextAction": "send"
                },
                {
                  "uuid": "no",
                  "value": false,
                  "nextAction": "invalid"
                }
              ],
              "nextAction": null
            },
            {
              "uuid": "invalid",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form",
                "method": "setStatus"
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "invalid-message"
            },
            {
              "uuid": "invalid-message",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form-state",
                "method": "merge",
                "value": {
                  "statusMessage": "请检查表单填写内容。"
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": null
            },
            {
              "uuid": "send",
              "action": "execute_ds",
              "inputs": {
                "dsConfig": {
                  "type": "API",
                  "domain": "mokelay",
                  "path": "/api/lark/reimbursement_submit",
                  "method": "POST",
                  "headerData": [],
                  "queryData": [],
                  "bodyData": [
                    {
                      "key": "id",
                      "dataType": "string",
                      "value": {
                        "template": "{{blocks['reimbursement-form-state'].record.id}}"
                      }
                    },
                    {
                      "key": "version",
                      "dataType": "number",
                      "value": {
                        "template": "{{blocks['reimbursement-form-state'].record.version}}"
                      }
                    },
                    {
                      "key": "show_help",
                      "dataType": "string",
                      "value": {
                        "template": "{{actions.validate.outputs.returnData.values.show_help}}"
                      }
                    },
                    {
                      "key": "category",
                      "dataType": "string",
                      "value": {
                        "template": "{{actions.validate.outputs.returnData.values.category}}"
                      }
                    },
                    {
                      "key": "fiat",
                      "dataType": "string",
                      "value": {
                        "template": "{{actions.validate.outputs.returnData.values.fiat}}"
                      }
                    },
                    {
                      "key": "crypto",
                      "dataType": "string",
                      "value": {
                        "template": "{{actions.validate.outputs.returnData.values.crypto}}"
                      }
                    },
                    {
                      "key": "loan",
                      "dataType": "string",
                      "value": {
                        "template": "{{actions.validate.outputs.returnData.values.loan}}"
                      }
                    },
                    {
                      "key": "note",
                      "dataType": "string",
                      "value": {
                        "template": "{{actions.validate.outputs.returnData.values.note}}"
                      }
                    }
                  ]
                }
              },
              "outputs": [
                "rawResponse"
              ],
              "nextAction": "store_record"
            },
            {
              "uuid": "store_record",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form-state",
                "method": "merge",
                "value": {
                  "record": {
                    "template": "{{actions.send.outputs.rawResponse.data.record}}"
                  },
                  "hideRetry": true
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "restore_fields"
            },
            {
              "uuid": "restore_fields",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form",
                "method": "setValues",
                "values": {
                  "settlement": {
                    "template": "{{actions.send.outputs.rawResponse.data.record.settlement}}"
                  }
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "submitted"
            },
            {
              "uuid": "submitted",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form-state",
                "method": "merge",
                "value": {
                  "submitted": true,
                  "hideRetry": true
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "receipt"
            },
            {
              "uuid": "receipt",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form",
                "method": "setStatus",
                "errors": []
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "receipt-message"
            },
            {
              "uuid": "receipt-message",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form-state",
                "method": "merge",
                "value": {
                  "statusMessage": {
                    "template": "已提交 · 申请单号 {{actions.send.outputs.rawResponse.data.record.id}}"
                  }
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": null
            }
          ],
          "execution": {
            "concurrency": "drop",
            "retry": "resumeUnconfirmed"
          },
          "onError": [
            {
              "uuid": "remember_failure",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form-state",
                "method": "merge",
                "value": {
                  "hideRetry": false,
                  "failedBlock": "reimbursement-submit",
                  "failedEvent": "click"
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "show_error"
            },
            {
              "uuid": "show_error",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form",
                "method": "setStatus",
                "errors": [
                  {
                    "message": {
                      "template": "{{event.error.message}}"
                    }
                  }
                ]
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "show_error-message"
            },
            {
              "uuid": "show_error-message",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form-state",
                "method": "merge",
                "value": {
                  "statusMessage": "提交失败"
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": null
            }
          ],
          "onFinally": [
            {
              "uuid": "finish",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form-state",
                "method": "merge",
                "value": {
                  "busy": false,
                  "locked": {
                    "template": "{{blocks['reimbursement-form-state'].submitted}}"
                  }
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": "unlock"
            },
            {
              "uuid": "unlock",
              "action": "call_block_method",
              "inputs": {
                "blockId": "reimbursement-form",
                "method": "setStatus",
                "loading": false,
                "disabled": {
                  "template": "{{blocks['reimbursement-form-state'].locked}}"
                }
              },
              "outputs": [
                "returnData"
              ],
              "nextAction": null
            }
          ]
        }
      ]
    }
  ]
}
